module Growthbook
  # Extendable cache for storing fetched feature payloads.
  class FeatureCache
    def get: (untyped key) -> untyped

    def set: (untyped key, untyped value, Integer? ttl) -> void
  end

  # Sample in-memory cache with TTL-based expiry (not shared across processes).
  class InMemoryFeatureCache < FeatureCache
    @store: Hash[untyped, { value: untyped, expires_at: Time? }]

    def initialize: () -> void

    def get: (untyped key) -> untyped

    def set: (untyped key, untyped value, Integer? ttl) -> void
  end
end
