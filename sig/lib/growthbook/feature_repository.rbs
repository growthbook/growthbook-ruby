module Growthbook
  # Optional class for fetching features from the GrowthBook API
  class FeatureRepository
    DEFAULT_TIMEOUT: Integer
    MIN_TIMEOUT: Integer

    @open_timeout: Integer
    @read_timeout: Integer

    def initialize: (endpoint: String, decryption_key: String?, ?open_timeout: Integer?, ?read_timeout: Integer?) -> void

    attr_reader endpoint: String
    attr_reader decryption_key: String?
    attr_reader features_json: Hash[String, untyped]
    attr_reader saved_groups_json: Hash[String, untyped]
    attr_reader open_timeout: Integer
    attr_reader read_timeout: Integer

    def fetch: () -> (nil | Hash[String, untyped])

    def fetch!: () -> (nil | Hash[String, untyped])

    private

    attr_reader response: String?

    def normalize_timeout: (Integer? seconds) -> Integer

    def parsed_plain_text_response: () -> (nil | Hash[String, untyped])

    def parsed_decrypted_response: () -> (nil | Hash[String, untyped])

    def decrypted_saved_groups: (Hash[String, untyped] parsed, String key) -> Hash[String, untyped]

    def parsed_response: () -> (nil | Hash[String, untyped])

    def use_decryption?: -> bool

    class FeatureFetchError < StandardError
    end

    class FeatureParseError < StandardError
    end
  end
end

module Net
  class HTTPSuccess
    
  end

  class HTTP
    def self.new: (untyped host, untyped port) -> HTTP
    def get_response: (String) -> untyped
    def use_ssl=: (bool) -> bool
    def open_timeout=: (Integer) -> Integer
    def read_timeout=: (Integer) -> Integer
    def get: (String) -> untyped
  end
end