module Growthbook
  class SSEClient
    DEFAULT_HEADERS: Hash[String, String]

    @uri: URI::Generic
    @host: String
    @on_event: ^({ type: String, data: String }) -> void
    @headers: Hash[String, String]
    @open_timeout: Integer | Float
    @read_timeout: Integer | Float
    @mutex: Thread::Mutex
    @thread: Thread?
    @connection: Net::HTTP?

    def initialize: (
        url: String,
        on_event: ^({ type: String, data: String }) -> void,
        ?headers: Hash[String, String],
        ?open_timeout: Integer | Float,
        ?read_timeout: Integer | Float
      ) -> void

    def start: () -> void

    def stop: (?timeout: Integer | Float) -> void

    def running?: () -> bool

    private

    def run: () -> void

    def close_connection: () -> void
  end
end

